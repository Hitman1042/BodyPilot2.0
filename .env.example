# ═══════════════════════════════════════════════════════════════
# BodyPilot 2.0 — пример файла окружения
# Скопируй в .env и заполни своими значениями
# ═══════════════════════════════════════════════════════════════

# ─── Telegram ─────────────────────────────────────────────────
# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=
# Username администратора (без @)
TELEGRAM_ADMIN_USERNAME=
# ID администраторов через запятую (например: 123456789,987654321)
TELEGRAM_ADMIN_USER_IDS=
# Режим команд бота: full / minimal
TELEGRAM_COMMAND_MODE=full

# ─── База данных ──────────────────────────────────────────────
# Путь к SQLite-файлу (по умолчанию data/bodypilot.db в корне проекта)
DATABASE_PATH=

# ─── AI / API-ключи ───────────────────────────────────────────
# Ключ Google Gemini (https://aistudio.google.com/apikey) — нужен для ИИ-функций
GEMINI_API_KEY=
# Основная модель Gemini (по умолчанию gemini-3.5-flash-lite — самая большая дневная квота)
GEMINI_MODEL=gemini-3.5-flash-lite
# Fallback-цепочка через запятую: при исчерпании дневной квоты (429) бот
# переключается на следующую модель. Квоты считаются по каждой модели отдельно.
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
# Ключ OpenAI (опционально)
OPENAI_API_KEY=
# Токен wger.de API (опционально — публичные эндпоинты работают без него)
WGER_API_TOKEN=

# ─── FatSecret Platform API (опционально) ─────────────────────
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# ─── Реферальная система ──────────────────────────────────────
# Соль для подписи реферальных ссылок — обязательно смени в проде!
REFERRAL_SECRET_SALT=bodypilot_ref_secret_change_me

# ─── Админка ──────────────────────────────────────────────────
# Пароль веб-админки (пусто = вход отключён)
ADMIN_PASSWORD=
# Ключ для админ-эндпоинтов API (/api/v1/admin/*, заголовок X-Admin-Key)
# Пусто = админ-API отключён (всегда 401)
ADMIN_API_KEY=

# ─── AI-лимиты ──────────────────────────────────────────────────
# false = лимиты выключены для всех (режим бета-теста),
# true = действуют лимиты Free/Premium (админы безлимитны всегда)
AI_LIMITS_ENABLED=false

# Ссылка на готовую команду Shortcuts (iOS) для автосинхронизации часов —
# создай команду «BodyPilot Sync» на своём iPhone, поделись через iCloud и вставь ссылку
WATCH_SYNC_IOS_LINK=

# ─── Планировщик ──────────────────────────────────────────────
# Интервал проверки дайджестов в минутах
DIGEST_CHECK_INTERVAL_MINUTES=1

# ─── Web API / Деплой ─────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Домен сервера (для Caddy TLS и Mini App), например: bodypilot.example.com
DOMAIN=

# ─── Telegram Mini App ────────────────────────────────────────
# https-URL веб-приложения (Mini App). Пусто = фича скрыта
# (кнопка «📱 Приложение» отвечает «скоро появится»).
# Для разработки: подними туннель `ngrok http 8000` и укажи URL с суффиксом /app,
# например: MINIAPP_URL=https://xxxx-xx-xx.ngrok-free.app/app
MINIAPP_URL=

# ─── Логирование ──────────────────────────────────────────────
# Уровень логов: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
